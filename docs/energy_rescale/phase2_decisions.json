  "cardAbilityEdits": [
    {
      "id": "9b9c2743-75b3-499d-b5fb-c3429c92d420",
      "find": "8●, ☪: This character gains +1✦.",
      "replace": "6●, ☪: This character gains +1✦.",
      "reason": "8● for +1 spark is too expensive; 6● is more playable"
    },
    {
      "id": "a75c22ac-e343-4757-964e-a0bb981b5a28",
      "find": "❖ – 10●: Allied spirit animals gain +3✦ and vengeful until end of turn.",
      "replace": "❖ – 9●: Allied spirit animals gain +3✦ and vengeful until end of turn.",
      "reason": "10● activation is prohibitively expensive for a 6-cost character; dropping to 9● keeps it costly but functional."
    },
    {
      "id": "7e4cca36-5134-415a-b30a-c4876b58976c",
      "find": "10●: Erode 1. That card gains reclaim 0●.",
      "replace": "9●: Erode 1. That card gains reclaim 0●.",
      "reason": "10● is prohibitively expensive for granting a single card reclaim 0●; reducing to 9● makes the ability occasionally usable while still being expensive."
    },
    {
      "id": "a5056a4c-542b-4a7c-8fe6-895126c7d4c8",
      "find": "8●: Abandon a ≤4● cost character.",
      "replace": "9●: Abandon a ≤4● cost character.",
      "reason": "The 8● activated ability is the engine that triggers the main passive (materialize 4✦ figment) on demand; at cost 12 the ability should also scale up by 1."
    },
    {
      "id": "ed4d5342-0690-40b7-ab48-6b76035466f2",
      "find": "8●, Abandon this character: Return a character from",
      "replace": "9●, Abandon this character: Return a character from",
      "reason": "The 8● + abandon ability to return a character from void is strong recursion at a relatively low cost; bumping to 9● brings it in line with the overall cost scaling."
    },
    {
      "id": "764b62f6-6af9-40ad-8d1f-653cc1a11030",
      "find": "6●: Store 1⧗.",
      "replace": "7●: Store 1⧗.",
      "reason": "Eclipse Herald's counter-storage ability is the engine that fuels its X⧗ dissolve. Storing counters for 6● is efficient given the dissolve payoff; bumping to 7● keeps the engine functional but slightly less efficient, consistent with the card's moderate power level at 6● cost. The dissolve ability (X⧗: Dissolve ≤X✦ enemy) is already gated by counter accumulation."
    },
    {
      "id": "ec4c1ea2-067d-49e4-9d21-9de3f64a05e3",
      "find": "8●: Gain 1⍟. This character gains +1✦.",
      "replace": "7●: Gain 1⍟. This character gains +1✦.",
      "reason": "Gleamshield Knight's activated ability costs 8● (the current maximum of early-game energy) to gain 1 VP and +1✦. This is prohibitively expensive for the effect. Reducing to 7● is still expensive but makes the ability usable. The card cost is being reduced by 1 as well (weak-for-cost), so keeping the ability cheaper aligns with the overall adjustment."
    },
    {
      "id": "d8c90a33-a581-469a-9fd3-9a80d1cc5315",
      "find": "10●, ☪, Abandon this character: Return all ≤4● cost characters from your void to play.",
      "replace": "11●, ☪, Abandon this character: Return all ≤4● cost characters from your void to play.",
      "reason": "Veilseeker's ultimate ability mass-reanimates all ≤4● characters from void — an exceptionally powerful effect that can flood the board. At 10● it is already very expensive, but given it also requires abandoning itself (Veilseeker leaves play as payment), bumping to 11● ensures the board-flood effect remains a true late-game desperation play. The card's base cost is already being judged fair at 6●."
    },
    {
      "id": "0637b453-4362-4f01-b3e6-07c27af9c847",
