# Production-only Vite env. Loaded by `vite build` (mode=production) and
# `vite preview`; ignored by `npm run dev` (mode=development), so local dev keeps
# serving art from the ~/Documents-symlinked public/ folders.
#
# This file holds the public production config that every build needs, so CI
# runners, fresh worktrees, and clean checkouts (which lack the gitignored local
# `.env`) build a working bundle and pass the firebase-config-guard plugin.

# Origin for binary game art (card/dreamcaller/dreamsign/atlas images). Points at
# the Firebase Storage bucket so the ~400 MB of art is served from the bucket
# instead of bundled into the Hosting deploy. Must match the bucket that
# scripts/upload-assets-to-storage.mjs publishes to. See
# docs/quest_prototype/asset-hosting.md.
VITE_ASSET_BASE_URL=https://storage.googleapis.com/quest-prototype-d7027.firebasestorage.app

# Firebase web client configuration for quest-prototype-d7027. These values are
# public: a Firebase web "API key" is a project identifier, not an authorization
# credential — it ships inside the client bundle and is already visible on the
# live site. Access is enforced by the Realtime Database security rules
# (database.rules.json), not by keeping these values private.
VITE_FIREBASE_API_KEY=AIzaSyDlAMFf4hgPO_fex4-aCK_kVYHV4j3N4eo
VITE_FIREBASE_AUTH_DOMAIN=quest-prototype-d7027.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://quest-prototype-d7027-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=quest-prototype-d7027
VITE_FIREBASE_APP_ID=1:1019031299594:web:155f262b7d11c6200261f3
VITE_FIREBASE_STORAGE_BUCKET=quest-prototype-d7027.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=1019031299594
